# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.
#
# Credentials and endpoints only. Everything else the agent needs — timeouts, the
# call ceiling, planner limits — is code with a default, not configuration, so it
# cannot drift out of step with the arithmetic that depends on it. Override one of
# those only if you know why; the defaults live in agent/agent.py and agent/llm.py.

# =============================================================================
# LLM (required)
# =============================================================================
# LLMod.ai API key for this group (create it in the LLMod.ai platform).
LLMOD_API_KEY=
# OpenAI-compatible base URL. The SDK appends /chat/completions, so this must
# include the /v1 path segment.
LLMOD_BASE_URL=https://api.llmod.ai/v1
# Not a secret, but provider configuration like the URL above, so it lives here.
# gpt-5* and o-series are treated as reasoning models: they take
# max_completion_tokens and reject a custom temperature, so switching between
# families changes which request parameters are sent. Leave unset to use the
# default in agent/llm.py.
LLMOD_MODEL=

# =============================================================================
# Live data (optional — each tool degrades to "unavailable" without its key)
# =============================================================================
# Geoapify: addresses, coordinates and OpenStreetMap opening hours for maps_tool.
GEOAPIFY_API_KEY=
# Tavily: web search and reviews, and the live local prices the planner costs from.
TAVILY_API_KEY=

# =============================================================================
# Supabase (optional — unconfigured, the agent runs exactly as it did before)
# =============================================================================
# Project URL, e.g. https://abcdefgh.supabase.co  (no trailing slash)
SUPABASE_URL=
# Service-role key. Server-side only — it bypasses RLS and must NEVER be exposed
# to the browser. Set it as a Vercel environment variable, not in client code.
SUPABASE_SERVICE_KEY=
# Fallback if you are only reading with an anon key and have written RLS policies.
SUPABASE_ANON_KEY=
