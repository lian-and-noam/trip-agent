# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# =============================================================================
# LLM (required)
# =============================================================================
# LLMod.ai API key for this group (create it in the LLMod.ai platform).
LLMOD_API_KEY=your-llmod-api-key-here
# OpenAI-compatible base URL. The SDK appends /chat/completions, so this must
# include the /v1 path segment.
LLMOD_BASE_URL=https://api.llmod.ai/v1
# Model name. Note gpt-5* and o-series are treated as reasoning models: they take
# max_completion_tokens and reject a custom temperature, so switching between
# families changes which request parameters are sent.
LLMOD_MODEL=gpt-4o-mini

# =============================================================================
# Budget guards (strongly recommended — the course allowance is $9 total)
# =============================================================================
# Per-1M-token rates for the model above, used to price every call. Leave unset
# and the agent still counts tokens and still enforces the call ceiling below,
# it just reports $0. Look the rates up for your model on LLMod.
LLM_PRICE_IN_PER_1M=
LLM_PRICE_OUT_PER_1M=
# Hard ceiling on LLM calls in a single /api/execute request. This is the real
# runaway protection: it works whether or not prices are configured.
LLM_MAX_CALLS_PER_RUN=12
# Cumulative spend ceiling for a warm instance, in USD. 0 disables the check.
# The durable total lives in Supabase: select public.total_spend_usd();
LLM_BUDGET_USD=0

# =============================================================================
# Timing (all three are bounded by vercel.json's maxDuration of 300s)
# =============================================================================
# Work budget: no new stage begins after this. Defaults to 230.
MAX_RUN_SECONDS=230
# Absolute stop for LLM calls. A call may START before this and is then truncated to the
# time remaining, so MAX_RUN_SECONDS + LLM_TIMEOUT_S does NOT have to fit inside 300 —
# the wall is what bounds a call, not the timeout. Leaves ~35s for the cold start, the
# Supabase round trips and serialising the reply. Defaults to 250. Raising this to 265
# was tried and a real run was killed by the platform at 300s.
HARD_WALL_SECONDS=250
# Per-call ceiling, not a budget. Measured on a 7-day plan: planner finalize 51-67s,
# Output Formatter 97s. Defaults to 110.
LLM_TIMEOUT_S=110

# =============================================================================
# Development: record/replay so iterating does not cost money
# =============================================================================
# off (default) | auto (replay if recorded, else record) | replay (strict, a miss
# is an error) | record (always call and overwrite). Never set this in production.
LLM_CASSETTE_MODE=
LLM_CASSETTE_DIR=.cassettes

# =============================================================================
# Supabase (optional — unconfigured, the agent runs exactly as it did before)
# =============================================================================
# Project URL, e.g. https://abcdefgh.supabase.co  (no trailing slash)
SUPABASE_URL=
# Service-role key. Server-side only — it bypasses RLS and must NEVER be exposed
# to the browser. Set it as a Vercel environment variable, not in client code.
SUPABASE_SERVICE_KEY=
# Fallback if you are only reading with an anon key and have written RLS policies.
SUPABASE_ANON_KEY=
# Per-request timeout for Supabase calls. Kept small so persistence can never
# block a turn; on timeout the agent simply proceeds without stored state.
SUPABASE_TIMEOUT_S=2.5
